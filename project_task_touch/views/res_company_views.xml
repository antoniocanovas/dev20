<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_company_view_form_project_task_touch" model="ir.ui.view">
        <field name="name">res.company.form.project_task_touch</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='general_info']" position="after">
                <page name="project_task_touch" string="Deadlines">
                    <group>
                        <field name="touch_activity_model_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
