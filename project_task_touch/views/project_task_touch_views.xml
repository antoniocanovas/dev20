<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_touch_action" model="ir.actions.client">
        <field name="name">Deadlines</field>
        <field name="tag">project_task_touch.screen</field>
        <!-- Also the start of the Odoo app installed on the tablet -->
        <field name="path">expedientes</field>
    </record>

    <!-- The tasks of the screen: the kanban of the tasks, by state, without creating there
         (with the button "New task" of the screen, that asks for the project) -->
    <record id="project_task_view_kanban_touch" model="ir.ui.view">
        <field name="name">project.task.kanban.touch</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="js_class">project_task_touch_kanban</attribute>
                <attribute name="default_group_by">state</attribute>
                <attribute name="quick_create">0</attribute>
                <attribute name="group_create">0</attribute>
                <attribute name="group_delete">0</attribute>
                <attribute name="group_edit">0</attribute>
                <attribute name="sample">0</attribute>
            </kanban>
        </field>
    </record>

    <!-- The tasks of the screen, as a list: the main list of the tasks, not grouped (the
         state is a column), ordered as the kanban by the screen -->
    <record id="project_task_view_list_touch" model="ir.ui.view">
        <field name="name">project.task.list.touch</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="default_group_by"></attribute>
                <attribute name="multi_edit">0</attribute>
                <attribute name="sample">0</attribute>
            </list>
            <!-- Its subtasks closed or added from the list, as on the kanban -->
            <field name="name" position="attributes">
                <attribute name="widget">project_task_touch_name_subtasks</attribute>
                <!-- Wide enough to read it, also on a tablet or a phone (the list scrolls sideways) -->
                <attribute name="width">[240]</attribute>
            </field>
            <!-- The deadline, shown by default: red when late, yellow today (relative_date) -->
            <field name="date_deadline" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>

    <menuitem id="project_task_touch_menu_root" name="Deadlines" action="project_task_touch_action"
              web_icon="project_task_touch,static/description/icon.png"
              groups="project.group_project_user" sequence="4"/>

</odoo>
