    </record>
    <record id="lot_ternera_02" model="stock.lot">
        <field name="name">FR4402987654</field>
        <field name="product_id" ref="product_canal_ternera"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="crotal_id" ref="crotal_ternera_02"/>
