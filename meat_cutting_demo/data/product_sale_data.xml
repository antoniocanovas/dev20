    <!-- Presentation prepared when the order is served: no variant, no stock of its
         own, a price extra per kg; the warehouse reads it on the delivery -->
    <record id="attribute_presentacion" model="product.attribute">
        <field name="name">Presentación</field>
        <field name="create_variant">no_variant</field>
        <field name="display_type">radio</field>
    </record>
    <record id="attribute_presentacion_entera" model="product.attribute.value">
        <field name="name">Pieza entera</field>
        <field name="attribute_id" ref="attribute_presentacion"/>
        <field name="default_extra_price">0.0</field>
    </record>
    <record id="attribute_presentacion_fileteado" model="product.attribute.value">
        <field name="name">Fileteado</field>
        <field name="attribute_id" ref="attribute_presentacion"/>
        <field name="default_extra_price">1.2</field>
    </record>
    <record id="attribute_presentacion_troceado" model="product.attribute.value">
        <field name="name">Troceado</field>
        <field name="attribute_id" ref="attribute_presentacion"/>
        <field name="default_extra_price">0.8</field>
    </record>
    <record id="attribute_presentacion_vacio" model="product.attribute.value">
        <field name="name">Envasado al vacío</field>
        <field name="attribute_id" ref="attribute_presentacion"/>
        <field name="default_extra_price">0.6</field>
    </record>
