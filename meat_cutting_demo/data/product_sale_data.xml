    <!-- Presentation kept in stock: its own product, with its own shelf life,
         made from the fresh cut (see its bill of materials) -->
    <record id="product_cerdo_solomillo_vacio" model="product.product">
        <field name="name">Solomillo de cerdo envasado al vacío</field>
        <field name="default_code">CER-SOL-V</field>
        <field name="barcode">8437000100478</field>
        <field name="categ_id" ref="product_category_cut"/>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="tracking">lot</field>
        <field name="use_expiration_date" eval="True"/>
        <field name="expiration_time">45</field>
        <field name="alert_time">5</field>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="list_price">12.30</field>
        <field name="meat_piece" eval="True"/>
        <field name="uom_ids" eval="[Command.link(ref('uom_pieza_cerdo_solomillo'))]"/>
    </record>

