        <field name="name">04</field>
        <field name="attribute_id" ref="product_attribute_calibre_granel"/>
        <field name="sequence">2</field>
    </record>
    <record id="product_attribute_calibre_granel_value_05" model="product.attribute.value">
        <field name="name">05</field>
        <field name="attribute_id" ref="product_attribute_calibre_granel"/>
        <field name="sequence">3</field>
    </record>

</odoo>
