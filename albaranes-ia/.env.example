# albaranes-ia: variables de entorno (copiar a .env; nunca subir .env al repositorio)
# En el servidor de pruebas: /root/albaranes-ia/.env (chmod 600), montado en albaranes-api como
# /run/config/albaranes-ia.env. Las no secretas están también en Easypanel → albaranes-api → Entorno.

# --- albaranes-api: ERP (capa sustituible; hoy Odoo 20 por JSON-2) ---
ERP_BACKEND=odoo
ODOO_URL=http://ia-support_odoo20:8069
ODOO_DB=odoo
ODOO_LANG=es_ES
# API key (ámbito rpc) del usuario integracion.albaranes. Caduca a los 90 días: regenerar con scripts/datos_prueba.py
ODOO_API_KEY=

# --- albaranes-api: BD propia de incidencias ---
STORE_PASSWORD=
STORE_DSN=postgresql://albaranes_ia:<STORE_PASSWORD>@ia-support_surtidos-db:5432/albaranes_ia

# --- albaranes-api: reglas y rectificación ---
DRY_RUN=true                 # true: la rectificación solo registra qué haría
CONFIANZA_UMBRAL=0.85        # por debajo, la línea va a revisión
VARIACION_SOSPECHOSA=0.5     # cambio relativo a partir del cual se marca "variación grande"
URL_REVISION=https://ia-support-n8n.kw2y1s.easypanel.host/webhook/albaranes/revision
API_TOKEN=                   # opcional: si se pone, la API exige la cabecera X-Api-Token

# --- albaranes-api: modelo de visión ---
VISION_PROVIDER=openrouter   # openrouter | anthropic
VISION_MODEL=anthropic/claude-sonnet-5.5   # con anthropic: claude-sonnet-5-5
# Opcionales: solo para la llamada directa /vision/leer. n8n usa su propia credencial.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- n8n: usuario de la credencial "Albaranes IA - Basic Auth" (webhooks) ---
REVISION_USER=revision
REVISION_PASSWORD=
