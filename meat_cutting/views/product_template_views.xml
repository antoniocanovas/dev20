<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_meat_cutting" model="ir.ui.view">
        <field name="name">product.template.form.meat.cutting</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_expiry.view_product_form_expiry"/>
        <field name="arch" type="xml">
            <field name="use_expiration_date" position="after">
                <field name="frozen_product_id" invisible="store_by not in ['lot', 'serial']"
                       options="{'no_quick_create': True}"/>
                <field name="meat_piece" invisible="not is_storable"/>
            </field>
        </field>
    </record>
</odoo>
