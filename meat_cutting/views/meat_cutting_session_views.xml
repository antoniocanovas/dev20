<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meat_cutting_session_view_list" model="ir.ui.view">
        <field name="name">meat.cutting.session.list</field>
        <field name="model">meat.cutting.session</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date"/>
                <field name="mode"/>
                <field name="picking_id" optional="show"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="package_id" optional="show"/>
                <field name="total_weight" sum="Total"/>
                <field name="consumed_qty" optional="show"/>
                <field name="uom_id" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="meat_cutting_session_view_form" model="ir.ui.view">
        <field name="name">meat.cutting.session.form</field>
        <field name="model">meat.cutting.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_cutting_screen" string="Cutting Screen" type="object" class="oe_highlight" invisible="state != 'draft' or not id"/>
                    <button name="action_validate" string="Validate" type="object" invisible="state != 'draft' or not line_ids"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_unbuild" type="object" class="oe_stat_button" icon="sync_alt" invisible="not unbuild_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Unbuild Order</span>
                            </div>
                        </button>
                        <button name="action_view_production" type="object" class="oe_stat_button" icon="factory" invisible="not production_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Manufacturing Order</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="mode"/>
                            <field name="production_id" invisible="1"/>
                            <field name="picking_id" readonly="state != 'draft'" invisible="mode != 'receipt'"/>
                            <field name="product_id" readonly="state != 'draft'"/>
                            <field name="tracking" invisible="1"/>
                            <field name="package_id" readonly="1" invisible="not package_id"/>
                            <field name="lot_id" readonly="state != 'draft'" invisible="tracking == 'none' or mode == 'production'"
                                   required="tracking != 'none' and mode != 'production'"/>
                            <field name="crotal_id" invisible="not lot_id"/>
                            <field name="bom_id" readonly="state != 'draft'" invisible="mode == 'preparation'"
                                   required="mode != 'preparation'"/>
                            <field name="production_qty" readonly="state != 'draft'" invisible="mode != 'production'"/>
                            <label for="consumed_qty"/>
                            <div class="o_row">
                                <field name="consumed_qty"/>
                                <field name="uom_id"/>
                            </div>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="location_id" readonly="state != 'draft'"/>
                            <field name="location_dest_id" readonly="state != 'draft'"/>
                            <field name="output_lot_name"/>
                            <field name="label_report_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="freeze" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cuts" name="cuts">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="product_id"/>
                                    <field name="can_freeze" column_invisible="True"/>
                                    <field name="freeze" readonly="not can_freeze" widget="boolean_toggle"/>
                                    <field name="output_product_id" optional="show"/>
                                    <field name="weight" sum="Total"/>
                                    <field name="uom_id"/>
                                    <field name="lot_name"/>
                                    <field name="package_id" optional="show"/>
                                    <field name="presentation_id" optional="show" options="{'no_create': True}"/>
                                    <field name="user_id" optional="hide"/>
                                    <field name="label_custom" optional="hide"/>
                                    <button name="%(meat_cutting.action_report_meat_cutting_label)d" type="action" icon="print" title="Print Label"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ingredients" name="ingredients" invisible="mode != 'production'">
                            <field name="consumption_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="product_id"/>
                                    <field name="package_id"/>
                                    <field name="lot_id"/>
                                    <field name="expiration_date"/>
                                    <field name="location_id" optional="hide"/>
                                    <field name="weight" sum="Total"/>
                                    <field name="uom_id"/>
                                    <field name="user_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="meat_cutting_session_view_search" model="ir.ui.view">
        <field name="name">meat.cutting.session.search</field>
        <field name="model">meat.cutting.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="picking_id"/>
                <field name="package_id"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_mode" string="Process" context="{'group_by': 'mode'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="meat_cutting_session_action" model="ir.actions.act_window">
        <field name="name">Cutting Sessions</field>
        <field name="res_model">meat.cutting.session</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cutting session yet</p>
            <p>Open the cutting screen to weigh and label the cuts of a carcass.</p>
        </field>
    </record>

    <record id="meat_cutting_line_view_list" model="ir.ui.view">
        <field name="name">meat.cutting.line.list</field>
        <field name="model">meat.cutting.line</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date"/>
                <field name="session_id"/>
                <field name="source_product_id"/>
                <field name="product_id"/>
                <field name="weight" sum="Total"/>
                <field name="uom_id"/>
                <field name="lot_name"/>
                <field name="package_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="meat_cutting_line_view_search" model="ir.ui.view">
        <field name="name">meat.cutting.line.search</field>
        <field name="model">meat.cutting.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="session_id"/>
                <field name="lot_name"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_product" string="Cut" context="{'group_by': 'product_id'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="meat_cutting_line_action" model="ir.actions.act_window">
        <field name="name">Weighed Cuts</field>
        <field name="res_model">meat.cutting.line</field>
        <field name="view_mode">list</field>
    </record>

    <record id="meat_cutting_screen_action" model="ir.actions.client">
        <field name="name">Cutting Screen</field>
        <field name="tag">meat_cutting_screen</field>
        <!-- Also the start of the app installed on the tablet (PWA) -->
        <field name="path">meat-cutting</field>
    </record>

    <menuitem id="meat_cutting_menu_root" name="Meat Cutting" web_icon="meat_cutting,static/description/icon.png"
              groups="mrp.group_mrp_user" sequence="56">
        <menuitem id="meat_cutting_menu_screen" action="meat_cutting_screen_action" sequence="10"/>
        <menuitem id="meat_cutting_menu_session" action="meat_cutting_session_action" sequence="20"/>
        <menuitem id="meat_cutting_menu_line" action="meat_cutting_line_action" sequence="30"/>
        <menuitem id="meat_cutting_menu_crotal" action="stock_crotal_action" sequence="40"/>
    </menuitem>
</odoo>
