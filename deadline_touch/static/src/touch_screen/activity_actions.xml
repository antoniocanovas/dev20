<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="deadline_touch.ActivityButtons">
        <div class="d-flex justify-content-end gap-1 o_deadline_touch_activity_buttons">
            <button class="btn btn-sm btn-secondary o_deadline_touch_activity_edit"
                    title="Edit the activity" aria-label="Edit the activity"
                    t-on-click.stop="this.onEdit">
                <i class="oi" data-icon="edit"/>
            </button>
            <button class="btn btn-sm btn-success o_deadline_touch_activity_done"
                    t-on-click.stop="(ev) => this.onDone(ev)">
                <i class="oi" data-icon="check"/> Done
            </button>
        </div>
    </t>

</templates>
