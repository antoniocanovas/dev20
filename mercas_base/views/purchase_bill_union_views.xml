<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_purchase_bill_union_list_invoice_mercas" model="ir.ui.view">
        <field name="name">purchase.bill.union.list.invoice.mercas</field>
        <field name="model">purchase.bill.union</field>
        <field name="inherit_id" ref="purchase.view_purchase_bill_union_list_invoice"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="mercas_receipts"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_bill_union_filter_mercas" model="ir.ui.view">
        <field name="name">purchase.bill.union.select.mercas</field>
        <field name="model">purchase.bill.union</field>
        <field name="inherit_id" ref="purchase.view_purchase_bill_union_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', '|', ('name', 'ilike', self), ('reference', 'ilike', self), ('mercas_receipts', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
