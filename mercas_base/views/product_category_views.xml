<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_category_form_view_mercas" model="ir.ui.view">
        <field name="name">product.category.form.mercas</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="is_merca"/>
            </field>
        </field>
    </record>

    <record id="product_category_list_view_mercas" model="ir.ui.view">
        <field name="name">product.category.list.mercas</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="is_merca" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
