<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_order_product_search_mercas" model="ir.ui.view">
        <field name="name">sale.report.search.mercas</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='Category']" position="after">
                <filter string="Quality" name="mercas_quality" context="{'group_by': 'mercas_quality'}"/>
                <filter string="Size" name="mercas_size" context="{'group_by': 'mercas_size'}"/>
            </xpath>
        </field>
    </record>

</odoo>
