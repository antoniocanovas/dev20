<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_purchase_order_form_mercas" model="ir.ui.view">
        <field name="name">purchase.order.form.mercas</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Purchase & Receive button next to Confirm -->
            <button name="button_confirm" position="after">
                <button name="button_purchase_and_receive"
                        string="Purchase &amp; Receive"
                        type="object"
                        class="btn-primary"
                        data-hotkey="r"
                        invisible="state not in ('draft', 'sent')"/>
            </button>

            <!-- Deliver Boxes button (visible on confirmed orders) -->
            <button name="button_purchase_and_receive" position="after">
                <button name="action_open_box_delivery"
                        string="Deliver Boxes"
                        type="object"
                        class="btn-secondary"
                        data-hotkey="e"
                        invisible="state != 'purchase'"/>
            </button>

            <!-- Receive & Invoice button (only for already confirmed box-return
                 orders: explicit action, not automatic on confirm) -->
            <button name="action_open_box_delivery" position="after">
                <button name="action_mercas_box_receive_and_invoice"
                        string="Receive &amp; Invoice"
                        type="object"
                        class="btn-secondary"
                        invisible="not mercas_is_box_return or state not in ('purchase', 'done')"/>
            </button>

            <!-- Print Labels button (visible on confirmed orders) -->
            <button name="action_mercas_box_receive_and_invoice" position="after">
                <button name="action_print_mercas_labels"
                        string="Print Labels"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ('purchase', 'done')"/>
            </button>

            <!-- Auxiliary fields for domain and column visibility -->
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="mercas_is_box_return" invisible="1"/>
                <field name="mercas_origin_country" invisible="1"/>
                <field name="mercas_origin_state" invisible="1"/>
                <field name="mercas_origin_filter" invisible="1"/>
            </xpath>

            <!-- lot_id domain: only lots without a supplier or with the same supplier and product -->
            <xpath expr="//field[@name='order_line']/list/field[@name='lot_id']"
                   position="attributes">
                <attribute name="domain">
                    [('product_id', '=', product_id), '|', ('partner_id', '=', False), ('partner_id', '=', parent.partner_id)]
                </attribute>
            </xpath>

            <!-- Boxes and Box columns after the quantity -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']"
                   position="after">
                <field name="box_qty" optional="show"/>
                <field name="box_product_id" optional="show"/>
                <field name="mercas_firm_negotiation" string="FN" optional="show"
                       help="FN: Firm Negotiation. The supplier is paid in full for what was received on this line, regardless of what was sold. Defaults to the value configured on the supplier, but can be changed here. It is carried over to the lot when the purchase is confirmed."/>
            </xpath>

            <!-- Country and state of origin columns -->
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']"
                   position="after">
                <field name="origin_country_id"
                       column_invisible="not parent.mercas_origin_country"
                       domain="[('mercas_origin', '=', True)] if parent.mercas_origin_filter else []"
                       optional="show"/>
                <field name="origin_state_id"
                       column_invisible="not parent.mercas_origin_state"
                       optional="show"/>
            </xpath>

        </field>
    </record>

</odoo>
