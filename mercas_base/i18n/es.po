#: model_terms:ir.ui.view,arch_db:mercas_base.view_stock_lot_form_mercas
msgid "Scrap"
msgstr "Desechar"

#. module: mercas_base
#: code:addons/mercas_base/models/stock_lot.py:0
msgid ""
"The firm negotiation of lot '%s' cannot be changed: it already has firm "
"invoicing recorded."
msgstr ""
"No se puede cambiar la negociación en firme del lote '%s': ya tiene "
"facturación en firme registrada."

#. module: mercas_base
#: code:addons/mercas_base/models/stock_lot.py:0
msgid "Only an Accounting Manager can change the firm negotiation of a lot."
msgstr ""
"Solo un Gestor de contabilidad puede cambiar la negociación en firme de un "
"lote."

#. module: mercas_base
#: code:addons/mercas_base/models/stock_lot.py:0
msgid ""
"Lot '%(lot)s' has purchase lines from different suppliers (%(partners)s). "
"For traceability, a lot can only be associated with a single supplier."
msgstr ""
"El lote '%(lot)s' tiene líneas de compra de distintos proveedores "
"(%(partners)s). Por trazabilidad, un lote solo puede estar asociado a un "
"único proveedor."

#. module: mercas_base
#: code:addons/mercas_base/models/stock_lot.py:0
