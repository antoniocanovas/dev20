<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Comments of the sale (mercas_comment), printed on the order, its
         invoices and its delivery slips -->

    <template id="report_saleorder_document_mercas_comment" inherit_id="sale.report_saleorder_document">
        <span name="order_note" position="before">
            <p t-if="doc.mercas_comment" name="mercas_comment" style="white-space: pre-line;" t-out="doc.mercas_comment"/>
        </span>
    </template>

    <template id="report_invoice_document_mercas_comment" inherit_id="account.report_invoice_document">
        <div name="comment" position="before">
            <p t-if="o.mercas_comment" name="mercas_comment" style="white-space: pre-line;" t-out="o.mercas_comment"/>
        </div>
    </template>

    <template id="report_delivery_document_mercas_comment" inherit_id="stock.report_delivery_document">
        <div name="signature" position="after">
            <p t-if="o.sale_id.mercas_comment" name="mercas_comment" class="mt-3" style="white-space: pre-line;" t-out="o.sale_id.mercas_comment"/>
        </div>
    </template>

</odoo>
