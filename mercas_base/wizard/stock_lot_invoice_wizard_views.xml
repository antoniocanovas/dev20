<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_stock_lot_invoice_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.invoice.wizard.form</field>
        <field name="model">stock.lot.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Invoice Completed Lots">
                <header>
                    <button name="action_liquidar" string="Settle"
                            type="object" class="btn-primary"/>
                    <button name="action_invoice_advance" string="Invoice Advance"
                            type="object" class="btn-secondary"/>
                    <button name="action_invoice_firm" string="Firm Invoice"
                            type="object" class="btn-secondary"/>
                </header>
                <group>
                    <field name="partner_id"/>
                    <field name="date_to"/>
                    <field name="show_all"/>
                </group>
                <field name="currency_id" invisible="1"/>
                <field name="line_ids">
                    <list create="0" delete="0" editable="bottom">
                        <field name="selected" readonly="not invoiceable" force_save="1" string=""/>
                        <field name="lot_id" readonly="1" force_save="1"/>
                        <field name="mercas_firm_negotiation" string="FN" widget="boolean_toggle" readonly="1" optional="show"/>
                        <field name="invoiceable" readonly="1" column_invisible="1"/>
                        <field name="ref" readonly="1" optional="hide"/>
                        <field name="create_date" readonly="1" string="Created"/>
                        <field name="company_id" readonly="1" optional="hide" groups="base.group_multi_company"/>
                        <field name="partner_ids" readonly="1" optional="hide" widget="many2many_tags"/>
                        <field name="completed" readonly="1" optional="show"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="purchase_kg" readonly="1" optional="show" sum="Purchased"/>
                        <field name="received_kg" readonly="1" optional="hide" sum="Received"/>
                        <field name="sale_kg" readonly="1" optional="hide" sum="Sold"/>
                        <field name="scrap_kg" readonly="1" optional="hide" sum="Scrapped"/>
                        <field name="product_qty" readonly="1" optional="show"/>
                        <field name="sale_amount" readonly="1" optional="hide" sum="Sold Amount"/>
                        <field name="net_invoiced_kg" readonly="1" optional="show" sum="Net Invoiced"/>
                        <field name="mercas_margin" readonly="mercas_firm_negotiation"/>
                        <field name="supplier_price_kg" readonly="mercas_firm_negotiation" invisible="mercas_firm_negotiation"/>
                        <field name="supplier_amount" readonly="1" invisible="mercas_firm_negotiation"/>
                        <field name="net_invoiced_amount" readonly="1" optional="hide" invisible="mercas_firm_negotiation" string="Invoiced" sum="Invoiced"/>
                        <field name="amount_to_invoice" readonly="1" string="To Invoice" sum="To Invoice"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer">
                    <field name="amount_total" widget="monetary"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Accessed from the Mercas menu: its own screen (not a modal dialog), so
         that once invoicing is done the breadcrumb ends up on the created
         invoice instead of revealing whatever was open before entering here. -->
    <record id="action_stock_lot_invoice_wizard_menu" model="ir.actions.act_window">
        <field name="name">Settlements</field>
        <field name="res_model">stock.lot.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
