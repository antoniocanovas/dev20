<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_stock_lot_change_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.change.wizard.form</field>
        <field name="model">stock.lot.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Correct Sale Lot">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="product_id" readonly="1"/>
                    <field name="sale_line_id" invisible="1"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    This corrects sale traceability (delivery line, delivered or
                    pending, sale order line and, if still in draft, the customer invoice) and
                    recalculates the sold kg/amount of each lot. If the delivery line was
                    already done, it also corrects the product's physical stock (stock.quant)
                    at the source and destination of that specific delivery, moving the
                    quantity from the old lot to the new one.
                </div>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="move_line_id" column_invisible="1" force_save="1"/>
                        <field name="current_lot_id" readonly="1" force_save="1"/>
                        <field name="quantity" readonly="1" force_save="1"/>
                        <field name="new_lot_id"
                               domain="[('product_id', '=', parent.product_id)]"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" string="Apply Correction"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
