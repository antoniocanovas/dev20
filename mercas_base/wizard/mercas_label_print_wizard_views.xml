<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_mercas_label_print_wizard_form" model="ir.ui.view">
        <field name="name">mercas.label.print.wizard.form</field>
        <field name="model">mercas.label.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Labels">
                <field name="purchase_id" invisible="1"/>
                <field name="sale_id" invisible="1"/>
                <group>
                    <field name="print_format"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0">
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="lot_id" readonly="1" force_save="1"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_print" string="Print Labels"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
