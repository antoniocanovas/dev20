<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_inherit_scrap_base" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.scrap_base</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="unbuild_type" readonly="state not in ('draft', 'sent')"/>
            </field>
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']" position="after">
                <field name="scrap_lot_name" optional="show" column_invisible="not parent.unbuild_type" readonly="parent.state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_list_inherit_scrap_base" model="ir.ui.view">
        <field name="name">purchase.order.list.inherit.scrap_base</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="unbuild_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_kpis_list_inherit_scrap_base" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.inherit.scrap_base</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="unbuild_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_search_inherit_scrap_base" model="ir.ui.view">
        <field name="name">purchase.order.search.inherit.scrap_base</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="To Dismantle" name="filter_unbuild_main" domain="[('unbuild_type', '=', 'main')]"/>
                <filter string="To Repair and Sell" name="filter_unbuild_refurbish" domain="[('unbuild_type', '=', 'refurbish')]"/>
                <filter string="Scrap Type" name="groupby_unbuild_type" context="{'group_by': 'unbuild_type'}"/>
            </xpath>
        </field>
    </record>

</odoo>
