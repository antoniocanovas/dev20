<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="res_partner_crm_scrap_inh_kanban" model="ir.ui.view">
        <field name="name">res.partner.crm.scrap.inh.kanban</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="type">kanban</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']//field[@name='parent_id']" position="after">
                <field name="ref" invisible="not ref" class="text-muted"/>
            </xpath>
        </field>
    </record>

    <record id="res_partner_crm_scrap_inh_form" model="ir.ui.view">
        <field name="name">res.partner.crm.scrap.inh.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="type">form</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//h1[field[@name='name']]" position="after">
                <div>
                    <field name="ref" placeholder="Referencia del cliente"/>
                </div>
            </xpath>
            <field name="category_id" position="attributes">
                <attribute name="options">{'color_field': 'color', 'no_create': True}</attribute>
            </field>
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='state_id']" position="attributes">
                <attribute name="placeholder">Provincia</attribute>
            </xpath>
        </field>
    </record>

    <record id="res_partner_crm_scrap_inh" model="ir.ui.view">
        <field name="name">res.partner.crm.scrap.inh</field>
        <field name="model">res.partner</field>
        <field name="type">list</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="phone" position="before">
                <field name="ref"/>
            </field>
            <field name="phone" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

</odoo>
