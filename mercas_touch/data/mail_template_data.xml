<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Documents of a delivery (delivery slip, DeCA) sent from the touch screen.
             The invoice goes with the standard invoice email instead. -->
        <record id="mail_template_delivery_documents" model="mail.template">
            <field name="name">Touch: Delivery Documents</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="subject">{{ object.company_id.name }} - {{ object.sale_id.name or object.name }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="description">Delivery slip and DeCA of a sale, sent from the touch screen</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,<br/><br/>
        Please find attached the documents of the delivery <strong t-out="object.name or ''">WH/OUT/00001</strong><t t-if="object.sale_id"> of your order <strong t-out="object.sale_id.name or ''">S00001</strong></t>.<br/><br/>
        Best regards,
        <t t-if="not is_html_empty(object.user_id.signature)">
            <br/><br/>
            <t t-out="object.user_id.signature or ''">--<br/>Mitchell Admin</t>
        </t>
    </p>
</div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
