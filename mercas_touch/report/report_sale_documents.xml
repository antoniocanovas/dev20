<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- The documents of a sale for the A4 printer, in a single PDF: delivery slips, DeCA,
         packing list and invoice (see models/ir_actions_report.py). The documents to
         print are chosen with data['kinds']; without them, all the available ones. -->
    <record id="action_report_sale_documents" model="ir.actions.report">
        <field name="name">Sale Documents</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mercas_touch.report_sale_documents</field>
        <field name="print_report_name">'Documents - %s' % object.name</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
